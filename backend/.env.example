# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.

# Cadena de conexión de Supabase:
# Dashboard > botón "Connect" > "Session pooler" (compatible con IPv4).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.tu-project-ref:TU_PASSWORD@aws-0-tu-region.pooler.supabase.com:5432/postgres

# SSL es obligatorio en Supabase. Ponlo en false solo para un PostgreSQL local.
DATABASE_SSL=true

PORT=3000

# Secreto para firmar los tokens JWT (cadena larga y aleatoria).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
# Duración del token (ej. 1h, 7d)
JWT_EXPIRES_IN=7d
